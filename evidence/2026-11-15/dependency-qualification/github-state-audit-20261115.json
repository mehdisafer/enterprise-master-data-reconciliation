        "patch": "@@ -0,0 +1,35 @@\n+version: 2.1\n+jobs:\n+  build-and-test:\n+    docker:\n+      - image: cimg/python:3.12\n+    steps:\n+      - checkout\n+      - restore_cache:\n+          keys:\n+            - mdm-uv-v1-{{ checksum \"uv.lock\" }}\n+      - run:\n+          name: Install locked Python environment\n+          command: |\n+            python -m pip install --disable-pip-version-check uv==0.13.6\n+            uv sync --frozen --extra dev\n+      - save_cache:\n+          key: mdm-uv-v1-{{ checksum \"uv.lock\" }}\n+          paths:\n+            - .venv\n+            - ~/.cache/uv\n+      - run:\n+          name: Lint\n+          command: uv run --extra dev ruff check src tests scripts .github/scripts\n+      - run:\n+          name: Diagnose test suite\n+          command: circleci testsuite doctor \"matching-unit\"\n+      - run:\n+          name: Run test suite\n+          command: circleci testsuite run \"matching-unit\"\n+      - store_test_results:\n+          path: test-results\n+workflows:\n+  build-and-test:\n+    jobs:\n+      - build-and-test"
      },

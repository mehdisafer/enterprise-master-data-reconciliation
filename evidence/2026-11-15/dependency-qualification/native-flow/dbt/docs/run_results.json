_name = a.attribute_value\n       \n   ))", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-15T21:25:25.696603Z", "completed_at": "2026-11-15T21:25:25.698913Z"}, {"name": "execute", "started_at": "2026-11-15T21:25:25.699240Z", "completed_at": "2026-11-15T21:25:25.699245Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.003342866897583008, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_mdm.no_conflicting_registration_ids", "compiled": true, "compiled_code": "with registrations as (\n    select m.golden_id,\n      (s.current_payload ->> 'country') as country,\n      \n      upper(regexp_replace((s.current_payload ->> 'registration_id'), '[^A-Za-z0-9]', '', 'g')) as registration_id\n      \n    from \"mdm_demo\".\"public\".\"memberships\" m\n    join \"mdm_demo\".\"public\".\"source_records\" s on s.source_key = m.source_key\n    where s.entity_type = 'organization'\n)\nselect golden_id\nfrom registrations\nwhere registration_id is not null and registration_id <> ''\ngroup by golden_id\nhaving count(distinct registration_id) > 1 or count(distinct country) > 1", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-15T21:25:25.691908Z", "completed_at": "2026-11-15T21:25:25.702573Z"}, {"name": "execute", "started_at": "2026-11-15T21:25:25.702974Z", "completed_at": "2026-11-15T21:25:25.702980Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.01203298568725586, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.enterprise_mdm.no_bitemporal_overlap", "compiled": true, "compiled_code": "-- Both validity and knowledge ranges must overlap for two slices to conflict.\nselect a.history_id, b.history_id as conflicting_history_id\nfrom \"mdm_demo\".\"public\".\"golden_history\" a\njoin \"mdm_demo\".\"pu